# Force LF line endings for all files that run on Linux,
# regardless of the checkout platform.
* text=auto

*.py    text eol=lf
*.sh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf
*.xacro text eol=lf
*.sdf   text eol=lf
*.urdf  text eol=lf
*.launch.py text eol=lf

# Binary assets — no line-ending conversion
*.dae   binary
*.png   binary
*.jpg   binary
*.pgm   binary
