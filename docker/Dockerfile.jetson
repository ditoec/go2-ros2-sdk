# Jetson NX 16 GB Dockerfile — ARM64 + CUDA 11.4 (JetPack 5.1.1)
#
# Base: dustynv/ros:humble-desktop-l4t-r35.3.1
#   - Ubuntu 20.04 LTS Focal (ARM64) — NOT 22.04: L4T r35.x (JetPack 5.x) ships a
#     Focal userland, and ROS2 Humble was only ever released with official binary
#     apt packages for Ubuntu 22.04/Jammy. dusty-nv compiles ROS2 Humble from
#     source against Focal instead, which means packages.ros.org's `focal` suite
#     carries NO `ros-humble-*` packages at all (verified: only foxy/galactic/
#     rolling are present) — `apt-get install ros-humble-<anything>` will always
#     fail "Unable to locate package" on this base, regardless of the specific
#     package. The `desktop` variant (vs `ros-base`) is used specifically because
#     it's compiled-from-source too and already bakes in rviz2, rmw_cyclonedds_cpp,
#     rqt_graph, rqt_image_view, and image_tools — the exact set this image needs.
#   - CUDA 11.4, cuDNN, TensorRT
#   - PyTorch: NOT pre-installed by this base image tag despite older docs
#     here claiming otherwise (verified against a clean container) -- dusty-nv
#     ships PyTorch as a separate tag (humble-pytorch-l4t-*). Installed
#     explicitly below via NVIDIA's official JetPack 5.1.1 CUDA wheel instead.
#
# GPU acceleration status on this image: torch has real CUDA support (the
# NVIDIA wheel above). onnxruntime (face recognition) and ctranslate2 (STT)
# are CPU-only -- neither has a working prebuilt CUDA wheel for aarch64/
# JetPack 5.1.1, and building either from source is a separate undertaking
# not yet done. FACE_DEVICE/STT_DEVICE default to cpu on Jetson accordingly.
#
# No simulation support on this image — Gazebo/ros_gz bridge packages hit the
# same Humble/Focal apt gap above with no source-built fallback in the base
# image, and simulation isn't needed onboard the physical robot anyway (USE_SIM
# is a dev-machine/x86 concern — see docker/Dockerfile). go2_sim and
# quadropted_msgs are excluded from this image's colcon build accordingly.
#
# Usage (hardware mode — the only supported mode on this image):
#   ROBOT_IP=192.168.x.x \
#     docker-compose -f docker/docker-compose.yml \
#                    -f docker/docker-compose.jetson.yml up
#
# Usage (offline voice, CPU STT — see GPU acceleration status above):
#   ROBOT_IP=192.168.x.x ENABLE_STT=true STT_PROVIDER=faster_whisper \
#     WHISPER_MODEL=small \
#     docker-compose -f docker/docker-compose.yml \
#                    -f docker/docker-compose.jetson.yml up
#
# Prerequisites on the Jetson host:
#   - JetPack 5.1.1 (L4T R35.3.1, CUDA 11.4, cuDNN installed)
#   - nvidia-container-toolkit  (sudo apt install nvidia-container-toolkit)
#   - Docker Engine 24+

# Versioned tag — pin the digest to prevent unexpected cache busts:
#   docker pull dustynv/ros:humble-desktop-l4t-r35.3.1 && .\docker\pin-base-image.ps1
FROM dustynv/ros:humble-desktop-l4t-r35.3.1

# Refresh the ROS2 apt signing key/source — Open Robotics' old key
# (F42ED6FBAB17C654) expired industry-wide in 2025, and this base image
# predates the rotation, so packages.ros.org fails GPG verification until
# the current ros-apt-source package is installed.
RUN apt-get update || true && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -f /etc/apt/sources.list.d/ros2.list /usr/share/keyrings/ros-archive-keyring.gpg && \
    ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F\" '{print $4}') && \
    curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo $VERSION_CODENAME)_all.deb" && \
    apt-get install -y /tmp/ros2-apt-source.deb && \
    rm -f /tmp/ros2-apt-source.deb && \
    rm -rf /var/lib/apt/lists/*

# System utilities — changes when adding/removing packages. rviz2,
# rmw_cyclonedds_cpp, rqt_graph, rqt_image_view, and image_tools all come
# pre-built from the humble-desktop base image (see header note) — none of
# them are apt-installable here, so they're not listed below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    python3-pip \
    portaudio19-dev \
    libpulse0 \
    ffmpeg \
    libgl1 \
    libgles2 \
    libopenblas-dev \
    xvfb \
    x11vnc \
    xfce4 \
    xfce4-terminal \
    xfce4-screenshooter \
    mousepad \
    dbus-x11 \
    x11-utils \
    x11-xserver-utils \
 && rm -rf /var/lib/apt/lists/*

# nanoflann (needed by nav2_route) has no apt package on this repo either
# ("[libnanoflann-dev] defined as 'not available' for OS version [focal]",
# per rosdep) -- it's a tiny header-only CMake project (an INTERFACE library,
# no compiled binaries), so building it from source is seconds of work, not
# a real undertaking. Installed as a plain system CMake package (not a
# colcon/ROS2 package), so find_package(nanoflann) resolves it normally.
RUN git clone --depth 1 https://github.com/jlblancoc/nanoflann.git /tmp/nanoflann && \
    mkdir -p /tmp/nanoflann/build && \
    cd /tmp/nanoflann/build && \
    cmake .. && \
    make install && \
    rm -rf /tmp/nanoflann

# ompl (needed by nav2_smac_planner) is a different case from nanoflann:
# rosdep has no mapping for it on this OS/distro combination ("No definition
# of [ompl] for OS version [focal]"), but it turns out apt genuinely has it
# under a normal (non-ROS) name -- confirmed via apt-cache policy: libompl-dev
# 1.4.2+ds1-5 is a real candidate from focal/universe. rosdep just doesn't
# know the mapping; the package itself is fine.
RUN apt-get update && apt-get install -y --no-install-recommends libompl-dev \
 && rm -rf /var/lib/apt/lists/*

# xtl/xsimd/xtensor (needed by nav2_mppi_controller) -- a prior version of
# this Dockerfile skipped nav2_mppi_controller entirely, wrongly assuming
# these were heavy C++ libraries not worth a from-source build for one
# optional controller plugin. They're actually the same category as
# nanoflann above: header-only INTERFACE libraries with no apt package on
# this repo (rosdep: "No definition of [xtensor]/[xsimd] for OS version
# [focal]"), just as cheap to build from source. Versions pinned to the
# 0.24.x/10.x/0.7.x line (rather than current master) to match what was
# contemporary when nav2_mppi_controller's Humble branch was written --
# xtensor's own compatibility table pairs 0.24.7 with xtl ^0.7.0 and xsimd
# ^10.0.0, reducing the risk of API drift against newer releases. Order
# matters: xtl and xsimd have no dependency on each other, but xtensor
# depends on both, so it must come last.
RUN git clone --depth 1 --branch 0.7.7 https://github.com/xtensor-stack/xtl.git /tmp/xtl && \
    mkdir -p /tmp/xtl/build && cd /tmp/xtl/build && cmake .. && make install && \
    cd / && rm -rf /tmp/xtl && \
    git clone --depth 1 --branch 10.0.0 https://github.com/xtensor-stack/xsimd.git /tmp/xsimd && \
    mkdir -p /tmp/xsimd/build && cd /tmp/xsimd/build && cmake .. && make install && \
    cd / && rm -rf /tmp/xsimd && \
    git clone --depth 1 --branch 0.24.7 https://github.com/xtensor-stack/xtensor.git /tmp/xtensor && \
    mkdir -p /tmp/xtensor/build && cd /tmp/xtensor/build && cmake .. && make install && \
    cd / && rm -rf /tmp/xtensor

WORKDIR /ros2_ws

# ── Layer 1: Python deps ──────────────────────────────────────────────────────
# PyTorch is NOT pre-installed in this base image (a prior version of this
# comment claimed it was -- verified false directly against a clean container:
# no torch module at all). dusty-nv ships PyTorch as a separate image tag
# (e.g. humble-pytorch-l4t-*), not bundled into humble-desktop. Without this
# explicit install, the first package below that unpins torch (sentence-
# transformers) silently pulls in a plain PyPI aarch64 wheel with no CUDA
# support at all (torch.cuda.is_available() == False) -- confirmed by testing.
# Installed here, before anything else touches torch -- but this alone isn't
# enough: the requirements.txt install below uses --ignore-installed (for
# unrelated reasons), which makes pip disregard this already-satisfied install
# and fetch a fresh plain wheel for any transitive torch dependency regardless
# (confirmed happening: torch showed up in that command's "Installing
# collected packages" list despite this step running first). A second forced
# reinstall runs after that block finishes, as the actual guarantee.
RUN pip install --no-cache \
    https://developer.download.nvidia.com/compute/redist/jp/v511/pytorch/torch-2.0.0+nv23.05-cp38-cp38-linux_aarch64.whl
ENV LD_LIBRARY_PATH="/usr/lib/llvm-8/lib:${LD_LIBRARY_PATH}"

# numpy is also excluded from the shared pin: requirements.txt hard-pins
# numpy==1.26.4 for open3d compatibility on other platforms (Python 3.10-3.11),
# but this image's Python is 3.8.10 (Focal's system interpreter, which is what
# ROS2 Humble's source-built rclpy bindings target -- see header note; there's
# no room to run a separate newer Python for just this package). numpy 1.26.4
# has no Python 3.8 wheel, so it's installed unpinned here instead, letting pip
# resolve whatever recent numpy still supports 3.8. open3d isn't used on Jetson.
#
# tokenizers (pulled in by faster-whisper) is pinned to 0.20.3: versions
# 0.21.0+ stopped shipping a cp38/aarch64 wheel (Python 3.8 hit EOL in Oct
# 2024), so pip falls back to building from source, which needs a Rust
# toolchain bootstrapped via `puccinialin` -- itself Python >=3.9-only, a dead
# end on this image. 0.20.3 has a prebuilt wheel and still satisfies
# faster-whisper's `tokenizers<1,>=0.13` constraint.
#
# ultralytics (YOLO) was previously excluded from this install with no
# separate install step anywhere else in this Dockerfile -- yolo_detector has
# never actually had it available on this image. Installed explicitly below,
# after torch, so it reuses the CUDA build instead of pulling its own.
COPY requirements.txt /ros2_ws/src/requirements.txt
RUN grep -vE '^(torch|ultralytics|numpy)' /ros2_ws/src/requirements.txt | \
    pip install --ignore-installed -r /dev/stdin "tokenizers==0.20.3" && \
    pip install --ignore-installed numpy && \
    pip install ultralytics

# The --ignore-installed installs above may have shadowed torch with a plain
# (non-CUDA) wheel again via a transitive dependency -- force the CUDA build
# back as the final word. --no-deps: only replace the torch package itself,
# its own already-satisfied deps (filelock, fsspec, jinja2, ...) don't need
# touching.
RUN pip install --no-cache --force-reinstall --no-deps \
    https://developer.download.nvidia.com/compute/redist/jp/v511/pytorch/torch-2.0.0+nv23.05-cp38-cp38-linux_aarch64.whl

# torchvision (needed by ultralytics/YOLO for torchvision.ops.nms) has no apt
# package and NVIDIA only ships prebuilt TorchVision wheels for JetPack 6, not
# 5.x (confirmed via an NVIDIA staff forum reply). `pip install ultralytics`
# above silently pulled in the latest PyPI torchvision (0.19, built against a
# much newer torch) -- this imports fine but crashes on the *first actual
# detection*, not at import time: "ModuleNotFoundError: No module named
# 'torch._custom_ops'" (that module doesn't exist in our pinned torch 2.0.0).
# Confirmed by actually running inference, not just importing -- `from
# ultralytics import YOLO` succeeding gives false confidence here, same
# lesson as go2_driver_node's list[int] crash earlier in this effort.
# torch 2.0.0's officially compatible pairing is torchvision 0.15.1
# (pytorch.org's version matrix) -- built from source here per dusty-nv's own
# jetson-inference install-pytorch.sh recipe for this exact torch version
# (same author as this image's base, and NVIDIA's forum staff point Jetpack
# 5.x users at exactly this script). ffmpeg is temporarily moved aside during
# the build -- torchvision's setup.py misdetects it otherwise, per the same
# script. The importlib_metadata upgrade is duplicated here (it's also
# applied later, in Layer 2, harmlessly idempotent) because torchvision's
# own setup.py needs it too: setuptools' _entry_points.py calls
# metadata.EntryPoints (added in importlib_metadata 3.6+), and at this point
# in Layer 1 the later upgrade hasn't run yet -- confirmed by a failed build
# ("AttributeError: module 'importlib_metadata' has no attribute
# 'EntryPoints'"), the identical bug already documented below for
# ament_python packages, just hit earlier in the file this time.
# pip uninstall first: the previous attempt used `python3 setup.py install`
# (legacy easy-install, not pip's wheel mechanism), which doesn't clean up
# the previous pip-installed torchvision 0.19's files before laying down
# 0.15.1's -- confirmed directly (cloned v0.15.1 and inspected it: no
# _meta_registrations.py exists in this tag's source at all, and its own
# __init__.py doesn't import one either), so the crash persisted identically
# after "successfully" building 0.15.1 with the stale 0.19 files still being
# the ones actually imported.
#
# `setup.py install` was then replaced with `pip install --no-build-isolation
# .` after IT ALSO failed differently: setup.py's egg-based easy-install
# mechanism apparently linked the installed package back to the build
# directory rather than copying it in, so `import torchvision` failed with
# "No module named 'torchvision'" once /tmp/torchvision was cleaned up --
# confirmed by a build where the .egg install step reported success but the
# immediate import check right after still failed. pip install produces a
# real wheel, copied into site-packages properly, avoiding that class of
# bug entirely. --no-build-isolation is required, not optional: torchvision's
# C extensions link against the actual installed torch via
# torch.utils.cpp_extension at build time -- pip's default build isolation
# would build inside a fresh venv that doesn't have our custom NVIDIA CUDA
# torch wheel installed, silently linking against the wrong torch (or
# failing outright).
RUN pip install --upgrade "importlib_metadata>=6.0" && \
    apt-get update && apt-get install -y --no-install-recommends \
      qtbase5-dev libjpeg-dev zlib1g-dev libomp-dev ninja-build \
 && rm -rf /var/lib/apt/lists/* && \
    pip uninstall -y torchvision && \
    mv /usr/bin/ffmpeg /usr/bin/ffmpeg.bak && \
    git clone --branch v0.15.1 --depth=1 https://github.com/pytorch/vision /tmp/torchvision && \
    pip install --no-cache --no-deps --no-build-isolation /tmp/torchvision && \
    rm -rf /tmp/torchvision && \
    mv /usr/bin/ffmpeg.bak /usr/bin/ffmpeg && \
    python3 -c "import torchvision; print('torchvision', torchvision.__version__, 'OK')"

# Heavy STT dep: faster-whisper pulls ctranslate2 (~250 MB native C++).
# Isolated so updating API SDKs below never re-downloads ctranslate2.
# CPU only on this image: PyPI has no CUDA ctranslate2 wheel for aarch64 at
# all (verified) -- GPU support would need a from-source build with
# -DWITH_CUDA=ON against this host's CUDA 11.4, not yet done. STT_DEVICE
# defaults to cpu on Jetson accordingly (see docker-compose.jetson.yml).
RUN pip install faster-whisper sounddevice

# Face recognition (Modul 4.2 — face_recognition_node). CPU only on this image:
# no working onnxruntime-gpu wheel exists for JetPack 5.1.1 specifically
# (community reports confirm wheels built for other JetPack versions fail with
# "not a supported wheel on this platform") -- GPU support would need a
# from-source build, not yet done. Plain `pip install insightface` pulls in
# CPU onnxruntime automatically. FACE_DEVICE defaults to cpu on Jetson
# accordingly (see docker-compose.jetson.yml). The verify line below confirms
# what's actually available rather than assuming.
RUN pip install insightface
RUN python3 -c "import onnxruntime as ort; print('onnxruntime providers:', ort.get_available_providers())"
RUN python3 -c "from insightface.app import FaceAnalysis; FaceAnalysis(name='buffalo_sc').prepare(ctx_id=-1); print('Face model (buffalo_sc) ready')"

# Light API clients (~5 MB pure Python) — updated more often than ctranslate2.
# google-genai excluded: no release, including the legacy google-generativeai
# package, ever shipped a stable build for Python 3.8 (checked the full version
# history -- every stable release requires >=3.9, some >=3.10). Gemini-based
# STT/NLU/TTS (NLU_PROVIDER=gemini, STT_PROVIDER=gemini/gemini_live,
# TTS_PROVIDER=gemini) are unavailable on this image; openai, faster_whisper,
# keyword NLU, and Supertonic TTS are unaffected.
# duckduckgo-search also excluded: it requires primp>=0.10.0, and every primp
# release in that range only ships manylinux_2_34 wheels (glibc >=2.34) --
# Focal's glibc is 2.31, so pip falls back to a source build needing the same
# unavailable Rust toolchain hit by tokenizers above. voice_cmd_node's
# _web_search() already wraps this import in try/except ImportError and
# degrades gracefully (logs a warning, returns ""), so this is a silent
# capability loss, not a crash, on this image.
RUN pip install openai anthropic websockets

# Piper TTS (default provider on this image, no API key required) — a
# standalone C++ binary invoked via subprocess, not a pip package, so unlike
# Supertonic (patched below to work around its own Python >=3.9 requirement)
# it has zero coupling to this image's Python 3.8 to begin with. Binary +
# English/Indonesian voice models are pre-baked here so the first container
# start is instant, matching the x86 Supertonic pattern.
RUN mkdir -p /opt/piper/voices && \
    curl -L -o /tmp/piper.tar.gz \
      https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_aarch64.tar.gz && \
    tar -xzf /tmp/piper.tar.gz -C /opt/piper --strip-components=1 && \
    rm -f /tmp/piper.tar.gz && \
    curl -L -o /opt/piper/voices/en_US-lessac-medium.onnx \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/en_US-lessac-medium.onnx && \
    curl -L -o /opt/piper/voices/en_US-lessac-medium.onnx.json \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium/en_US-lessac-medium.onnx.json && \
    curl -L -o /opt/piper/voices/id_ID-news_tts-medium.onnx \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/id/id_ID/news_tts/medium/id_ID-news_tts-medium.onnx && \
    curl -L -o /opt/piper/voices/id_ID-news_tts-medium.onnx.json \
      https://huggingface.co/rhasspy/piper-voices/resolve/main/id/id_ID/news_tts/medium/id_ID-news_tts-medium.onnx.json && \
    echo "Piper voice ready." | /opt/piper/piper \
      --model /opt/piper/voices/en_US-lessac-medium.onnx \
      --output_file /tmp/piper_selftest.wav && \
    rm -f /tmp/piper_selftest.wav

ENV PIPER_BINARY=/opt/piper/piper
ENV PIPER_VOICES_DIR=/opt/piper/voices

# Supertonic TTS (TTSProvider_Supertonic in tts_node.py already exists and is
# platform-agnostic -- it was simply never installable on this image). PyPI's
# supertonic package declares requires-python>=3.9 and imports cleanly fail
# on 3.8 with "TypeError: 'type' object is not subscriptable": core.py,
# pipeline.py, loader.py, and utils.py all use real Python 3.9+ builtin
# generic type-hint subscripting (list[str], tuple[np.ndarray, np.ndarray],
# set[str]) in actual function signatures -- confirmed by reading every file
# in the package, not assumed. Same class of bug as camera_config.py earlier
# in this effort, same fix: `from __future__ import annotations` defers all
# annotations to lazy strings. cli.py and server/ are skipped -- __init__.py
# only imports from .config/.core/.pipeline, so they're never imported for
# our use (no `serve` extra installed) regardless of their own syntax.
# Cloned from source (not `pip install supertonic`, which the >=3.9 gate
# blocks outright) so the patch and the requires-python relaxation in
# pyproject.toml can both be applied before a local `pip install .`.
# soundfile/huggingface-hub are pinned below the version each library itself
# dropped Python 3.8 support (0.14.0 and 1.0.0 respectively need >=3.10) --
# confirmed via PyPI release metadata -- while staying above supertonic's own
# >=0.10.0 floor for both. onnxruntime>=1.19.0/numpy>=1.21.0 are already
# satisfied by what insightface installed earlier (1.19.2 / 1.24.4).
#
# pyproject.toml's `license = "MIT"` (PEP 639 bare SPDX string syntax) is
# also patched to the older `license = {text = "MIT"}` dict form -- pip's
# isolated build environment resolves its own fresh setuptools per PEP 517,
# and that one doesn't understand the newer bare-string form yet ("invalid
# pyproject.toml config: `project.license` must be valid exactly by one
# definition"), confirmed by a failed build. The old dict form has always
# been valid, so it's compatible with whichever setuptools version pip's
# isolation happens to resolve.
RUN pip install --no-cache "soundfile==0.13.1" "huggingface-hub==0.17.0" && \
    git clone --depth 1 https://github.com/supertone-inc/supertonic-py.git /tmp/supertonic-py && \
    sed -i '1i from __future__ import annotations' \
      /tmp/supertonic-py/supertonic/core.py \
      /tmp/supertonic-py/supertonic/pipeline.py \
      /tmp/supertonic-py/supertonic/loader.py \
      /tmp/supertonic-py/supertonic/utils.py && \
    sed -i 's/requires-python = ">=3.9"/requires-python = ">=3.8"/' \
      /tmp/supertonic-py/pyproject.toml && \
    sed -i 's/^license = "MIT"$/license = {text = "MIT"}/' \
      /tmp/supertonic-py/pyproject.toml && \
    pip install --no-cache --no-deps /tmp/supertonic-py && \
    rm -rf /tmp/supertonic-py && \
    python3 -c "from supertonic import TTS; print('Supertonic import OK')"

# ── Layer 2: ROS2 package deps ───────────────────────────────────────────────
# go2_sim and quadropted_msgs (simulation-only) are deliberately excluded —
# see header note. lidar_processor_cpp is also excluded: it needs pcl_ros,
# another ros-humble-* package that doesn't exist on this apt repo (same
# Humble/Focal gap as everything else pulled from packages.ros.org here).
# lidar_processor (the pure-Python equivalent, built successfully) already
# covers this. Nothing else in this workspace depends on any of the three.
COPY coco_detector/package.xml       /ros2_ws/src/coco_detector/package.xml
COPY go2_description/package.xml    /ros2_ws/src/go2_description/package.xml
COPY go2_interfaces/package.xml     /ros2_ws/src/go2_interfaces/package.xml
COPY go2_robot_sdk/package.xml      /ros2_ws/src/go2_robot_sdk/package.xml
COPY lidar_processor/package.xml    /ros2_ws/src/lidar_processor/package.xml
COPY speech_processor/package.xml   /ros2_ws/src/speech_processor/package.xml
COPY yolo_detector/package.xml      /ros2_ws/src/yolo_detector/package.xml

# SLAM Toolbox and Nav2 have no ros-humble-* apt packages on this repo (same
# Humble/Focal gap as everything else pulled from packages.ros.org here) and
# aren't baked into the humble-desktop base image either. Clone and build them
# from source instead -- their package.xml files need to land in the workspace
# before the rosdep step below so their own transitive dependencies get
# resolved too.
#
# Foxglove Bridge is NOT cloned here. First attempt failed with "Could not
# find catkin" (root cause found: ros-foxglove-bridge was archived and merged
# into the foxglove-sdk monorepo, where the buildable ROS2 packages now live
# nested under ros/src/, alongside unrelated Rust/Python/C++/TypeScript SDK
# build files at the repo root that the old clone-the-whole-repo approach
# handed to colcon too). Cloning just ros/src/foxglove_bridge + ros/src/
# foxglove_msgs fixed that, but surfaced a second, deeper problem: foxglove_
# bridge's own dependency rosx_introspection needs <span> (C++20 stdlib),
# which this image's GCC 9.4.0 toolchain's libstdc++ doesn't ship (added in
# GCC 10+) -- confirmed via a full build attempt, not assumed. g++-10 isn't
# in this image's default apt sources either (would need a PPA). Deferred as
# a separate, deeper follow-up rather than blocking this round's other fixes.
# ENABLE_FOXGLOVE=false remains the working default -- see docker-compose.jetson.yml.
#
# bond_core (bond/bondcpp) is also cloned: nav2_util depends on bondcpp for
# lifecycle-node heartbeat monitoring, and it's a separate core ROS2 package
# (not part of the navigation2 monorepo) with the same missing-apt-package
# problem -- rosdep flagged it too ("No definition of [bond] for OS version
# [focal]").
#
# BehaviorTree.CPP v3.8 provides behaviortree_cpp_v3, which nav2_behavior_tree
# depends on -- Nav2 Humble targets the v3 API specifically (v4 is a breaking
# rewrite used by Iron+), and like everything else here it has no apt package
# on this repo ("No definition of [behaviortree_cpp_v3] for OS version
# [focal]", per rosdep). v3.8 is a tag, not a branch.
#
# diagnostic_updater (part of ros/diagnostics) is needed by
# nav2_lifecycle_manager. No dedicated humble branch exists on this repo
# (branches stop at galactic; master is the current unified ROS2 branch
# covering humble/iron/jazzy/kilted via package.xml conditionals, same
# pattern as foxglove_bridge's main -- unlike foxglove_bridge this one
# actually builds cleanly under colcon).
#
# twist_mux/twist_mux_msgs (go2_robot_sdk's own exec_depend, arbitrates
# /cmd_vel_out between voice/joy/follow/nav priorities) and
# pointcloud_to_laserscan (converts /point_cloud2 -> /scan for Nav2) both
# hit the exact same Humble/Focal apt gap as everything else here ("No
# definition of [twist_mux]/[pointcloud_to_laserscan] for OS version
# [focal]", rosdep only maps either for jammy) -- but unlike the packages
# above, these went undetected through every prior build in this effort:
# both are pure launch-time Python/exec dependencies with no C++ target
# linking against them, so `colcon build` succeeds with them completely
# absent. Only surfaced when robot.launch.py was actually run ("package
# 'twist_mux' not found"). twist_mux_msgs is its own separate repo (a
# twist_mux exec_depend), cloned first since twist_mux needs it.
RUN git clone --branch humble --depth 1 \
      https://github.com/SteveMacenski/slam_toolbox.git \
      /ros2_ws/src/slam_toolbox && \
    git clone --branch humble --depth 1 \
      https://github.com/ros-navigation/navigation2.git \
      /ros2_ws/src/navigation2 && \
    git clone --branch humble --depth 1 \
      https://github.com/ros/bond_core.git \
      /ros2_ws/src/bond_core && \
    git clone --branch v3.8 --depth 1 \
      https://github.com/BehaviorTree/BehaviorTree.CPP.git \
      /ros2_ws/src/behaviortree_cpp_v3 && \
    git clone --depth 1 \
      https://github.com/ros/diagnostics.git \
      /ros2_ws/src/diagnostics && \
    git clone --branch master --depth 1 \
      https://github.com/ros-teleop/twist_mux_msgs.git \
      /ros2_ws/src/twist_mux_msgs && \
    git clone --branch humble --depth 1 \
      https://github.com/ros-teleop/twist_mux.git \
      /ros2_ws/src/twist_mux && \
    git clone --branch humble --depth 1 \
      https://github.com/ros-perception/pointcloud_to_laserscan.git \
      /ros2_ws/src/pointcloud_to_laserscan

# nav2_route (route-graph navigation, part of the core Nav2 stack this project
# needs) has two compile bugs against this specific base image, both patched
# here rather than skipping the package:
#
# 1. geojson_graph_file_loader.cpp calls std::filesystem::exists() but never
#    includes <filesystem> -- relies on it being pulled in transitively on
#    whatever toolchain upstream CI uses, which doesn't happen here.
#
# 2. Two files (start_pose_orientation_scorer.hpp AND goal_orientation_scorer.hpp
#    -- confirmed via grep -rl across the whole navigation2 + slam_toolbox tree,
#    no other files affected) include "tf2/utils.hpp". That header only exists
#    on tf2's current upstream humble branch -- this base image's tf2 was
#    source-built back on 2023-12-05 (confirmed via
#    /opt/ros/humble/log/build_2023-12-05_21-43-24/tf2), predating the .hpp
#    split: only tf2/utils.h exists in this image (verified directly --
#    find turned up utils.h and impl/utils.h, no utils.hpp anywhere under
#    /opt/ros/humble/install/include/tf2). navigation2's humble branch is a
#    moving target synced against a newer tf2 than this pinned base ships.
#    grep -rl (not two hardcoded paths) so a future `git pull` on this branch
#    picking up a third occurrence doesn't silently reintroduce this failure.
RUN sed -i '/#include <fstream>/a #include <filesystem>' \
      /ros2_ws/src/navigation2/nav2_route/src/plugins/graph_file_loaders/geojson_graph_file_loader.cpp && \
    grep -rl 'tf2/utils.hpp' /ros2_ws/src/navigation2/nav2_route | \
      xargs sed -i 's|#include "tf2/utils.hpp"|#include "tf2/utils.h"|'

RUN apt-get update && \
    . /opt/ros/${ROS_DISTRO}/install/setup.sh && \
    rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y && \
    rm -rf /var/lib/apt/lists/*

# One of the many pip installs above pulled in a newer setuptools than the
# installed importlib_metadata supports (setuptools' _entry_points.py calls
# metadata.EntryPoints, added in importlib_metadata 3.6+) -- colcon's
# ament_python build step shells out to `setup.py --help-commands` using this
# same site-packages, so every ament_python package (coco_detector,
# lidar_processor, yolo_detector, ...) fails identically until this is fixed.
RUN pip install --upgrade "importlib_metadata>=6.0"

# ── Layer 3: Source + build ───────────────────────────────────────────────────
# COPY . still brings go2_sim/quadropted_msgs/lidar_processor_cpp source into
# the image (COPY can't selectively exclude subdirectories mid-tree), so skip
# them explicitly at build time instead — none of their package.xml were
# registered above, and building them would pull in apt packages this image
# can't get (Gazebo/ros_gz, pcl_ros).
#
# -DBUILD_TESTING=OFF: this image only ever runs `colcon build`, never
# `colcon test`, so there's no reason to compile test binaries at all --
# confirmed necessary when nav2_costmap_2d's test/unit/obstacle_layer_test.cpp
# failed on a missing tf2_ros header (tf2_ros itself is fine; only the test
# target's own extra include path was the problem).
#
# nav2_system_tests is skipped explicitly, not just via -DBUILD_TESTING=OFF:
# it's a top-level colcon package in its own right (Gazebo-based integration
# tests), not a test target embedded inside another package, so the CMake
# flag alone doesn't skip building it -- confirmed by it still failing after
# every other package succeeded. Needs gazebo_ros_pkgs, unavailable on this
# image for the same reason go2_sim/quadropted_msgs are excluded above (no
# simulation support here). Nothing but tests either way.
COPY . /ros2_ws/src
RUN find /ros2_ws/src -type f \( -name "*.py" -o -name "*.sh" \) \
      -exec sed -i 's/\r$//' {} \; && \
    chmod +x /ros2_ws/src/docker/entrypoint.sh && \
    . /opt/ros/${ROS_DISTRO}/install/setup.sh && \
    colcon build --packages-skip go2_sim quadropted_msgs lidar_processor_cpp \
      nav2_system_tests \
      --cmake-args -DBUILD_TESTING=OFF

RUN echo "source /opt/ros/${ROS_DISTRO}/install/setup.bash" >> /root/.bashrc && \
    echo "source /ros2_ws/install/setup.bash" >> /root/.bashrc

ENV ROBOT_IP=""
ENV CONN_TYPE="webrtc"
ENV WEBRTC_SERVER_HOST="0.0.0.0"
ENV WEBRTC_SERVER_PORT="9991"
ENV USE_SIM="false"

# VNC — default password "ros2vnc", override with VNC_PASSWORD at runtime
ENV DISPLAY=:1
ENV VNC_PORT=5901
ENV VNC_RESOLUTION=1920x1080

RUN mkdir -p /root/.vnc

RUN sed --in-place --expression \
      '$isource "/ros2_ws/install/setup.bash"' \
      /ros_entrypoint.sh

CMD []
