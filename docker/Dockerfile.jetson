# Jetson NX / Orin Dockerfile — ARM64 + CUDA 12 (JetPack 6)
#
# Base: dustynv/ros:jazzy-ros-base-l4t-r36.4.0
#   - Ubuntu 22.04 LTS (ARM64)
#   - CUDA 12, cuDNN, TensorRT
#   - PyTorch for ARM64+CUDA pre-installed (avoids the 20-min pip build)
#   - ROS2 Jazzy base
#
# Usage (bare Jetson):
#   docker build -f docker/Dockerfile.jetson -t go2-ros2-sdk:jetson .
#
# Usage (docker-compose, Tier 2 offline voice):
#   ROBOT_IP=192.168.x.x ENABLE_STT=true STT_PROVIDER=faster_whisper \
#     STT_DEVICE=cuda WHISPER_MODEL=small \
#     docker-compose -f docker/docker-compose.yml \
#                    -f docker/docker-compose.jetson.yml up
#
# The GPU deploy block in docker-compose.yml must be uncommented for cuda to work.
# nvidia-container-toolkit must be installed on the Jetson host.

FROM dustynv/ros:jazzy-ros-base-l4t-r36.4.0

# Simulation packages are excluded — Gazebo runs on the external PC, not on the robot.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    python3-pip \
    portaudio19-dev \
    ffmpeg \
    ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-topic-tools \
    ros-jazzy-tf-transformations \
    ros-jazzy-rqt-graph \
    ros-jazzy-rqt-image-view \
    ros-jazzy-image-tools \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws

# ── Layer 1: Python deps ──────────────────────────────────────────────────────
# PyTorch is already installed in the L4T base image with CUDA support.
# Only install non-torch requirements here.
COPY requirements.txt /ros2_ws/src/requirements.txt
RUN grep -vE '^(torch|ultralytics)' /ros2_ws/src/requirements.txt | \
    pip install --break-system-packages --ignore-installed -r /dev/stdin

# STT + TTS local inference (Tier 2 — offline, CUDA-accelerated)
# faster-whisper CTranslate2 wheels are available for aarch64+CUDA via PyPI.
RUN pip install --break-system-packages \
    faster-whisper \
    sounddevice \
    kokoro-onnx \
    openai \
    google-genai \
    anthropic

# ── Layer 2: ROS2 package deps ───────────────────────────────────────────────
COPY coco_detector/package.xml       /ros2_ws/src/coco_detector/package.xml
COPY go2_description/package.xml    /ros2_ws/src/go2_description/package.xml
COPY go2_interfaces/package.xml     /ros2_ws/src/go2_interfaces/package.xml
COPY go2_robot_sdk/package.xml      /ros2_ws/src/go2_robot_sdk/package.xml
COPY go2_sim/package.xml            /ros2_ws/src/go2_sim/package.xml
COPY lidar_processor/package.xml    /ros2_ws/src/lidar_processor/package.xml
COPY lidar_processor_cpp/package.xml /ros2_ws/src/lidar_processor_cpp/package.xml
COPY quadropted_msgs/package.xml    /ros2_ws/src/quadropted_msgs/package.xml
COPY speech_processor/package.xml   /ros2_ws/src/speech_processor/package.xml
COPY yolo_detector/package.xml      /ros2_ws/src/yolo_detector/package.xml
RUN apt-get update && \
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y && \
    rm -rf /var/lib/apt/lists/*

# ── Layer 3: Source + build ───────────────────────────────────────────────────
COPY . /ros2_ws/src
RUN find /ros2_ws/src -type f \( -name "*.py" -o -name "*.sh" \) \
      -exec sed -i 's/\r$//' {} \; && \
    chmod +x /ros2_ws/src/docker/entrypoint.sh && \
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc && \
    echo "source /ros2_ws/install/setup.bash" >> /root/.bashrc

ENV ROBOT_IP=""
ENV CONN_TYPE="webrtc"
ENV WEBRTC_SERVER_HOST="0.0.0.0"
ENV WEBRTC_SERVER_PORT="9991"
ENV USE_SIM="false"

RUN sed --in-place --expression \
      '$isource "/ros2_ws/install/setup.bash"' \
      /ros_entrypoint.sh

CMD []
