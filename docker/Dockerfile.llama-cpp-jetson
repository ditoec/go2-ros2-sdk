# Builds llama.cpp server for Jetson Orin NX 16 GB (ARM64, JetPack 5.1.1, CUDA 11.4).
#
# GPU architecture defaults to SM 87 (Ampere — Jetson Orin NX / Orin AGX).
# Override at build time for other Jetson generations:
#   SM 72  — Jetson Xavier NX / AGX Xavier (Volta)
#   SM 87  — Jetson Orin NX / Orin Nano / AGX Orin (Ampere)   ← default
#
# Build-time argument:
#   docker build --build-arg CUDA_ARCH=72 -f docker/Dockerfile.llama-cpp-jetson .
#
# Base image: the generic nvidia/cuda repo targets ARM SBSA (server-class ARM64 +
# discrete/datacenter GPU), not Jetson's Tegra iGPU — it is not the right family
# for Jetson regardless of CUDA version. dustynv/ros:humble-ros-base-l4t-r35.3.1 is
# reused here (same image Dockerfile.jetson is built from) specifically because its
# CUDA 11.4 toolkit is already confirmed to match this L4T generation's host
# libraries — verified via the nvidia-container-runtime CSV-mount mechanism used by
# the main Jetson image. A narrower dustynv/cuda-only base likely also exists for
# r35.3.1 but wasn't confirmed working end-to-end; this trades some extra image
# weight (unused ROS packages) for that certainty.
FROM --platform=linux/arm64 dustynv/ros:humble-ros-base-l4t-r35.3.1

ARG CUDA_ARCH=87

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake curl git libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Shallow clone + build only llama-server target (~12 min on first run, cached after)
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp /build && \
    cmake /build -B /build/build \
        -DBUILD_SHARED_LIBS=OFF \
        -DGGML_CUDA=ON \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
        -DLLAMA_CURL=ON \
    && cmake --build /build/build --config Release \
        -j$(nproc) --target llama-server \
    && cp /build/build/bin/llama-server /usr/local/bin/llama-server \
    && rm -rf /build

EXPOSE 8080
ENTRYPOINT ["llama-server"]
