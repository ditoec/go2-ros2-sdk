<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_robot_sdk</name>
  <version>0.0.0</version>
  <description>ROS2 unofficial sdk for Unitree Go2</description>
  <maintainer email="abizov94@gmail.com">brimo</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>go2_interfaces</depend>
  <!-- unitree_go: needed as its own real package, not a go2_interfaces
       clone. ROS2's rosidl toolchain bakes the package name into each
       message's DDS wire-level type identifier, so a go2_interfaces-typed
       subscriber can never receive data from the robot firmware's native
       unitree_go-typed publisher on the CycloneDDS ingest topics
       (sportmodestate/lowstate/wirelesscontroller), even with identical
       fields. See go2_driver_node.py's import comment for the confirmed
       symptom. Not on any ros-humble-* apt index, so it's vendored from
       source in every Dockerfile (docker/Dockerfile, Dockerfile.windows-gpu,
       Dockerfile.jetson). -->
  <depend>unitree_go</depend>
  <!-- unitree_api: the CycloneDDS command path (cyclonedds_adapter.py)
       publishes to /api/sport/request using this package's Request/Response
       messages, not unitree_go's simpler Req/Res. Confirmed live that the
       robot's actual command receiver on that topic (and all 9 native
       robot-side publishers sharing it) are typed unitree_api/msg/Request,
       not unitree_go/msg/Req. Same vendoring story as unitree_go: not on
       any ros-humble-* apt index, sourced from the same unitree_ros2 repo,
       vendored from source in every Dockerfile. -->
  <depend>unitree_api</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>twist_mux</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_util</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  
  <exec_depend>slam_toolbox</exec_depend>

  <exec_depend>foxglove_bridge</exec_depend>

  <!-- Simulation dependencies (only needed for simulation.launch.py) -->
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <exec_depend>cv_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
